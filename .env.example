# Server Port
PORT=3000

# Administrator Credentials
ADMIN_EMAIL="raihanhossenpabel678@gmail.com"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"
JWT_SECRET="YOUR_CRYPTOGRAPHIC_JWT_SECRET"

# Supabase PostgreSQL Configuration (Optional: Persistent local engine active by default)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Client-side Supabase keys (if direct client queries are enabled)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Application URL
APP_URL="https://your-domain.com"
